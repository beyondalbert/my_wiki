# Flask
SECRET_KEY=change-me-to-a-random-secret
FLASK_ENV=development
FLASK_DEBUG=1

# MySQL
DATABASE_URL=mysql+pymysql://root:password@127.0.0.1:3306/my_wiki?charset=utf8mb4

# AI (OpenAI compatible endpoint, e.g. OpenAI / DeepSeek / Tongyi)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-xxx
CHAT_MODEL=gpt-4o-mini

# AI Wiki output directory (Karpathy style markdown files)
AI_WIKI_DIR=instance/ai_wiki

# Optional: RAG augmentation
ENABLE_RAG=false
EMBEDDING_MODEL=text-embedding-3-small
CHROMA_PATH=instance/chroma

# Upload
UPLOAD_DIR=instance/uploads
MAX_CONTENT_LENGTH=33554432
